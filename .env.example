# PostgreSQL local (configura estos valores según tu instalación de PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/tecnouam
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-with-your-local-postgresql-password

# Backend
SERVER_PORT=8080
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-64-characters-xxxxxxxxxxxxxxxx
JWT_EXPIRATION_MINUTES=120

# Frontend
VITE_API_URL=http://localhost:8080/api
